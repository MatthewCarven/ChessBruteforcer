+def repeating_moves(board: chess.Board) -> list[chess.Move]:
+    """
+    The legal moves that bring back a position the game has had already.
+
+    BruteForceBot (2026-10-25): the book took no account of repetition. In rsJhY1E7 every one of our moves came from
+    it, 6...Qa5+ 7.Nc3 Qb6 8.Na4 Qa5+ 9.Nc3 Qb6, a draw by threefold repetition at move 9 against a bot rated ~140
+    below us. A book move that repeats a position is left out, from every book; when no other is left, the engine
+    decides, with the repetition in its search.
+    """
+    repeats = []
+    for move in board.legal_moves:
+        board.push(move)
+        if board.is_repetition(2):
+            repeats.append(move)
+        board.pop()
+    return repeats
+
