+logger = logging.getLogger(__name__)
+NNUE_MAGIC = b"CBNNUE01"  # our .nnue files start with it and end with the SHA-256 of everything before it
 
-def game_specific_options(game: model.Game) -> OPTIONS_TYPE:  # noqa: ARG001
+
+def game_specific_options(game: model.Game) -> OPTIONS_TYPE:
     """
     Return a dictionary of engine options based on game aspects.
 
-    By default, an empty dict is returned so that the options in the configuration file are used.
+    BruteForceBot (2026-10-25, Matthew's (a)): the net named in bot\\eval\\net.txt, read as each game starts, so the
+    net changes between games with no restart (bot\\use-net.cmd writes the file; games on keep theirs). No file, or
+    nothing in it but blank lines and # notes: the config's net, make-config.py's choice. A name is a file in
+    bot\\eval or a full path. A net that isn't there or doesn't check out (cut, damaged, still being copied) is
+    logged, and the config's net plays.
     """
-    return {}
+    path = os.environ.get("BRUTEFORCER_NET")
+    if not path:
+        return {}
+    try:
+        with open(path, encoding="utf-8-sig") as f:
+            lines = [line.strip().strip('"').strip() for line in f]
+    except OSError:
+        return {}
+    name = next((line for line in lines if line and not line.startswith("#")), "")
+    if not name:
+        return {}
+    net = os.path.abspath(os.path.join(os.path.dirname(path), name))
+    try:
+        with open(net, "rb") as f:
+            data = f.read()
+    except OSError:
+        logger.warning(f"net.txt names {name}, which isn't there: game {game.id} plays on the config's net")
+        return {}
+    if not data.startswith(NNUE_MAGIC) or hashlib.sha256(data[:-32]).digest() != data[-32:]:
+        logger.warning(f"net.txt names {name}, which isn't a whole .nnue net (cut, damaged or still being copied): "
+                       f"game {game.id} plays on the config's net")
+        return {}
+    logger.info(f"Game {game.id} plays on {name} (bot\\eval\\net.txt)")
+    return {"EvalFile": net}
 
 
