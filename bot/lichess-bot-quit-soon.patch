+# BruteForceBot (2026-10-20): stopping once the games are over. Matthew drops bot\quit.soon (bot\quit-soon.cmd makes
+# it; a "quit.soon.txt" from Explorer counts too): lichess-bot declines new challenges with "later" (lichess.org tells
+# the challenger "This is not the right time for me, please ask again later."; a decline can't carry words of its
+# own), withdraws its own, makes no new ones, says QUIT_SOON_GOODBYE at the end of the games still on, and stops when
+# none is left. run-bot.ps1 names the file in BRUTEFORCER_QUIT_SOON, deletes it after that stop and starts nothing;
+# deleting it sooner cancels the stop.
+QUIT_SOON_GOODBYE = ("Good game! Sorry, no new challenges at this time: we're going to sleep, and when we wake up "
+                     "we'll be even better!")
+
+
+def quit_soon() -> bool:
+    """Whether the quit.soon file is there (named by BRUTEFORCER_QUIT_SOON; without that, never)."""
+    path = os.environ.get("BRUTEFORCER_QUIT_SOON")
+    return bool(path) and (os.path.exists(path) or os.path.exists(path + ".txt"))
+
+
+def start_quitting(li: lichess.Lichess, challenge_queue: MULTIPROCESSING_LIST_TYPE,
+                   matchmaker: matchmaking.Matchmaking, active_games: dict[str, str]) -> None:
+    """quit.soon has appeared: decline the challenges waiting for a slot, and withdraw the bot's own."""
+    logger.info(f"quit.soon is there: no new challenges; lichess-bot stops once no game is in play "
+                f"({len(active_games)} now)")
+    while challenge_queue:
+        chlng = challenge_queue.pop(0)
+        logger.info(f"Decline {chlng} (later): quit.soon")
+        li.decline_challenge(chlng.id, reason="later")
+    if matchmaker.challenge_id:
+        logger.info(f"Cancel challenge {matchmaker.challenge_id}: quit.soon")
+        with contextlib.suppress(Exception):
+            li.cancel(matchmaker.challenge_id)
+        matchmaker.discard_challenge(matchmaker.challenge_id)
+
+
+def decline_while_quitting(event: EventType, li: lichess.Lichess, user_profile: UserProfileType) -> None:
+    """A challenge that comes while quit.soon is there: declined with "later"."""
+    chlng = model.Challenge(event["challenge"], user_profile)
+    if chlng.from_self:
+        return
+    logger.info(f"Decline {chlng} (later): quit.soon")
+    li.decline_challenge(chlng.id, reason="later")
+
+
