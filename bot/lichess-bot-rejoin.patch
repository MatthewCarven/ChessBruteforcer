+REJOIN_TRIES = 10  # BruteForceBot: how many times a game's stream is opened again before giving the game up
+
+
+def rejoin_game_stream(li: lichess.Lichess, game_id: str, responses: list[requests.models.Response],
+                       logger: logging.Logger) -> Iterator[bytes] | None:
+    """
+    Open a game's stream again after it ended or failed while the game was still on, or None if it's over.
+
+    BruteForceBot (2026-10-17): lichess.org sometimes closes a game's stream mid-game, and lichess-bot left the game,
+    which then ran out of time unplayed. The new stream's first line is the whole game; its state goes first, so play
+    carries on from wherever the game has got to. Each response opened goes into `responses`, to be closed at the end.
+    """
+    for attempt in range(1, REJOIN_TRIES + 1):
+        if not game_is_active(li, game_id):
+            return None
+        try:
+            response = li.get_game_stream(game_id)
+            responses.append(response)
+            lines = response.iter_lines()
+            full = json.loads(next(lines).decode("utf-8"))
+        except (HTTPError, ReadTimeout, RemoteDisconnected, ChunkedEncodingError, RequestsConnectionError,
+                StopIteration, ValueError, lichess.RateLimitedError) as e:
+            logger.info(f"Game {game_id}: couldn't open its stream again ({attempt} of {REJOIN_TRIES}: {e!r})")
+            time.sleep(2)
+            continue
+        logger.info(f"Game {game_id}: its stream ended mid-game; rejoined (try {attempt})")
+        return itertools.chain([json.dumps(full.get("state", full)).encode("utf-8")], lines)
+    return None
+
