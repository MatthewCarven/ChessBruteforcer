     /// Score for the side to move, in centipawns: the network's when the position carries one
     /// (<see cref="Position.UseNetwork"/>; the UCI option EvalFile with a .nnue file), the numbers' otherwise.
     /// </summary>
-    public static int Evaluate(Position position) =>
-        position.Accumulators is { } network ? network.Evaluate(position.SideToMove) : Evaluate(position, Parameters);
+    public static int Evaluate(Position position)
+    {
+        if (position.Accumulators is not { } network)
+            return Evaluate(position, Parameters);
+        switch (Nnue.Probe.Mode)
+        {
+            case 1:
+            {
+                int value = network.Evaluate(position.SideToMove);
+                Nnue.Probe.Record(value);
+                return value;
+            }
+            case 2:
+                return Nnue.Probe.Values[Nnue.Probe.Next++];
+            case 3:
+            {
+                int value = network.Evaluate(position.SideToMove), recorded = Nnue.Probe.Values[Nnue.Probe.Next++];
+                if (value != recorded)
+                    Nnue.Probe.Mismatches++;
+                return recorded;
+            }
+            default:
+                return network.Evaluate(position.SideToMove);
+        }
+    }
 
